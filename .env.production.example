# Production environment for the Oracle Cloud VM (http://129.225.68.122:8080).
# Copy to .env.production on the VM, edit, then run: bash deploy/deploy.sh
ENVIRONMENT=production

# Server-side Groq key used for internal agent calls (optional; users can
# also bring their own key per request from the frontend).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CORS: which frontend origins may call this API. Comma-separated list —
# include every local dev machine origin that should reach the VM backend.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
